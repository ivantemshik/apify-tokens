{
  "name": "apify-account-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "init": "node src/cli.js init",
    "check": "node --env-file-if-exists=.env src/cli.js check",
    "mail:check": "node --env-file-if-exists=.env src/cli.js check-mail",
    "mail:sync": "node --env-file-if-exists=.env src/cli.js sync-mail",
    "start": "node --env-file-if-exists=.env src/cli.js run",
    "status": "node --env-file-if-exists=.env src/cli.js status",
    "export": "node --env-file-if-exists=.env src/cli.js export",
    "test": "node --test test/core.test.js test/pochti.test.js",
    "test:browser": "node --test test/browser.test.js",
    "browser:install": "node src/cli.js install-browser"
  },
  "dependencies": {
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "playwright": "^1.50.0"
  }
}
