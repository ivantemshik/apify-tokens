# init generates a random local encryption key. Keep a separate backup.
VAULT_KEY=
CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY=
CAPTCHA_TIMEOUT_MS=180000
MAX_CAPTCHA_TASKS_PER_ACCOUNT=2
CAPTCHA_TOTAL_BUDGET_USD=
CAPTCHA_BUDGET_FILE=data/captcha-budget.json

# pochti (read-only mailbox access), imap, or http.
MAIL_PROVIDER=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_FOLDER=INBOX
# Empty means the account email; set a catch-all login if appropriate.
IMAP_USER=
MAIL_PASSWORD=
MAIL_TIMEOUT_MS=180000
MAIL_POLL_MS=5000

# HTTP contract documented in README. URL must contain {email}.
MAIL_API_URL=
MAIL_API_TOKEN=

# Existing pochti deployment. The CLI reads mail; issue helpers create mailbox rows.
# Source files and server configuration are not copied or changed.
POCHTI_PROJECT=C:/path/to/pochti
POCHTI_SSH_HOST=root@mail.example.com
POCHTI_SSH_PORT=22
POCHTI_SSH_KEY=
POCHTI_KNOWN_HOSTS=
POCHTI_REMOTE_CONFIG=/etc/tempmail/config.json
# Any known mailbox of the owner whose active addresses should be imported.
POCHTI_ANCHOR_EMAIL=

HEADLESS=true
ACCOUNTS_FILE=accounts.jsonl
VAULT_FILE=data/accounts.vault.json
TOKEN_DESCRIPTION=local-automation
# Stop after this many verified tokens; empty means all addresses.
RUN_TARGET_TOKENS=
# Optional JSON file to override browser selectors for UI changes.
SELECTORS_FILE=
